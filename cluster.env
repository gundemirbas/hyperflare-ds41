#
# Cluster coordinates. Every script in this directory runs on the control node
# and reaches the other hosts over SSH as SSH_USER.

# Rank zero. Holds the controller identity, answers Orbit commands, builds and
# holds the node image, and serves rank zero of the model.
CONTROL_HOST=192.168.0.248

# aarch64 host that builds the node image; one of the serving hosts, because the
# compiler has to match them.
BUILD_HOST=192.168.0.248

# Serving hosts in rank order.
NODES="192.168.0.248 192.168.0.247 192.168.0.246"

SSH_USER=xexnaor

# Orbit names.
CLUSTER=ds41
GROUP=ds41-tp3

# Serving parameters.
CONCURRENCY=6

# Preparation. The checkpoint stays on the source host; the preparation host
# mounts it read-only over SSHFS rather than copying it.
CHECKPOINT_SSH="xexnaor@192.168.0.245:/home/xexnaor/cont/ds41/models/DeepSeek-V4.1-Flash-1017"
CHECKPOINT_MOUNT=/home/xexnaor/flare-source
SPECULATIVE_TOKEN_CAPACITY=64

# Prepared core on rank zero. Empty picks the newest under CORE_ROOT.
CORE=
CORE_ROOT=/home/xexnaor/.cache/flare/cores

# Prefix cache: local disk tier only. A multi-host instance needs the disk tier,
# because a rank's host prefix store has to see every rank.
PREFIX_DISK=/home/xexnaor/.cache/flare/prefix
PREFIX_DISK_LIMIT=100G

# Publisher trust for the prepared core.
PUBLISHER_KEYS=/home/xexnaor/.config/flare/development-publisher.json
PUBLISHER_NAMESPACE=local-development
APPROVE_KEY=797eb564fec3a0371bf56c7bfa3cef2978246963138c154989eb07f1e9d6e9ce

# Where the complete core is archived on the control node, so a host that loses
# its cache is restored without another export.
ARCHIVE_ROOT=/home/xexnaor/cont/ds41/core-archive

# Commit the build pins. An object id, not a branch: a moving branch can reject
# a build that a fixed tree would accept.
COMMIT=f872b08d27f5afa88dd28c1a08e8f71150fa0eb8
