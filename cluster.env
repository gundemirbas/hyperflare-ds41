#
# Cluster coordinates for the deploy scripts. Everything in this directory runs
# on the control node; the scripts reach the other hosts over SSH as SSH_USER.

# Control node: runs the registry, the controller container and these scripts.
CONTROL_HOST=192.168.0.245

# aarch64 host that builds the node image. It has to match the serving hosts.
BUILD_HOST=192.168.0.248

# Serving hosts in rank order.
NODES="192.168.0.248 192.168.0.247 192.168.0.246"

# Registry the Sparks pull from.
REGISTRY=192.168.0.245:5000

SSH_USER=xexnaor

# Orbit names.
CLUSTER=ds41
GROUP=ds41-tp3

# Preparation parameters.
CONCURRENCY=6
SPECULATIVE_TOKEN_CAPACITY=64
COMMIT=main

# Checkpoint, mounted over SSHFS on the preparation host.
CHECKPOINT_SSH="xexnaor@192.168.0.245:/home/xexnaor/cont/ds41/models/DeepSeek-V4.1-Flash-1017"
CHECKPOINT_MOUNT=/home/xexnaor/flare-source

# Selene pool every serving rank attaches to; all ranks must use the same value.
POOL_ADDR=192.168.0.245:9200

# Prepared core on the first node. Empty picks the newest under CORE_ROOT.
CORE=
CORE_ROOT=/home/xexnaor/.cache/flare/cores

# Prefix cache tiers. The local disk tier is mandatory: a pool alone is rejected
# with "the host prefix store requires every rank in one process".
PREFIX_DISK=/home/xexnaor/.cache/flare/prefix
PREFIX_DISK_LIMIT=100G

# Publisher trust for the core.
PUBLISHER_KEYS=/home/xexnaor/.config/flare/development-publisher.json
PUBLISHER_NAMESPACE=local-development
APPROVE_KEY=797eb564fec3a0371bf56c7bfa3cef2978246963138c154989eb07f1e9d6e9ce

# Patch files under patches/, space separated, applied to the node image build.
# Empty builds the plain FLARE_COMMIT checkout.
PATCHES=

# Where the complete core is archived on the control node, so the source node can
# stop holding the other ranks' payloads.
ARCHIVE_ROOT=/home/xexnaor/cont/ds41/core-archive
