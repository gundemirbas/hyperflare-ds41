# One image for a serving node: the native `flare` binary and the Ignition
# preparation environment. The binary is extracted and installed on the host;
# preparation runs inside the image with the GPUs attached.
#
# Build on an aarch64 Spark so the compiler matches the serving hosts:
#   docker build -f Containerfile -t flare-node:latest .
FROM rust:1.94.1-bookworm AS rustbuild

ARG FLARE_REPOSITORY=https://github.com/NVIDIA/hyperflare-inference.git
ARG FLARE_COMMIT=main

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates git cmake nasm ninja-build pkg-config \
        protobuf-compiler libssl-dev liburing-dev libibverbs-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --filter=blob:none "${FLARE_REPOSITORY}" /src \
    && cd /src && git checkout "${FLARE_COMMIT}"

# Optional local forks from patches/, applied before the binary is built. An
# empty list builds the plain checkout. A patch that only touches Rust leaves the
# preparation layer below unchanged.
ARG FLARE_PATCHES=""
COPY patches/ /src/patches/
RUN cd /src && for patch in ${FLARE_PATCHES}; do git apply "/src/patches/${patch}"; done

WORKDIR /src
RUN cargo build --release --locked --manifest-path flare-cli/Cargo.toml

FROM nvidia/cuda:13.0.0-devel-ubuntu24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG FLARE_REPOSITORY=https://github.com/NVIDIA/hyperflare-inference.git
ARG FLARE_COMMIT=main

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl git \
        build-essential cmake ninja-build pkg-config nasm \
        protobuf-compiler libssl-dev liburing-dev \
        libibverbs1 libibverbs-dev rdma-core libnuma1 \
        python3 python3-venv python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Heliopause is a Rust extension, so the preparation environment needs cargo.
RUN curl -LsSf https://sh.rustup.rs -o /tmp/rustup.sh \
    && sh /tmp/rustup.sh -y --profile minimal --default-toolchain stable \
    && rm -f /tmp/rustup.sh

RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && install -m 0755 /root/.local/bin/uv /usr/local/bin/uv \
    && install -m 0755 /root/.local/bin/uvx /usr/local/bin/uvx

RUN git clone --filter=blob:none "${FLARE_REPOSITORY}" /src \
    && cd /src && git checkout "${FLARE_COMMIT}"
COPY --from=rustbuild /src/flare-cli/target/release/flare /usr/local/bin/flare

WORKDIR /src
RUN BUILD_NVEP=0 FLASHINFER_BUILD_NO_PIP=1 \
    PATH=/usr/local/cuda/bin:$PATH CUDA_HOME=/usr/local/cuda \
    python3 scripts/setup_preparation.py

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

ENV PATH=/src/.venv/bin:/root/.cargo/bin:/usr/local/cuda/bin:/usr/local/bin:$PATH \
    CUDA_HOME=/usr/local/cuda \
    HF_HUB_DISABLE_TELEMETRY=1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["ignition", "--help"]
